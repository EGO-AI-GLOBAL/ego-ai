# Modelo para os Segredos do Streamlit (Cloud: Manage app → Secrets; local: copie para secrets.toml).
# O ficheiro TOML NÃO pode começar com a palavra "toml" — só linhas chave = "valor".
# Não faça commit de chaves reais no GitHub.

GOOGLE_API_KEY = "COLE_SUA_CHAVE_DO_GOOGLE_AI_STUDIO"
# URL do projeto: tem de ser https://ALGO.supabase.co (nunca só https://supabase.co)
SUPABASE_URL = "https://xxxxxxxx.supabase.co"
# Em Supabase: Settings → API → Project API keys → anon public
SUPABASE_KEY = "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
