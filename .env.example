# =============================================================================
# EGO-AI — modelo do .env na RAIZ (copie para .env e preencha)
# Nunca faça commit do ficheiro .env
# Para o app Expo use também: app/.env (ver app/.env.example)
# =============================================================================

# --- Supabase (login, perfil, histórico) ---
SUPABASE_URL=
SUPABASE_KEY=
# Necessário na API (Railway) para convidar membros em agendas compartilhadas por e-mail:
# SUPABASE_SERVICE_ROLE_KEY=

# --- Gemini (chat texto + microfone fallback) ---
GOOGLE_API_KEY=
EGO_GEMINI_MODEL_FLASH=gemini-2.5-flash
EGO_GEMINI_FLASH_ONLY=1

# --- OpenAI Realtime (Chamada ao vivo no browser) — SÓ AQUI, nunca no app/ ---
OPENAI_API_KEY=
EGO_OPENAI_REALTIME=1
EGO_REALTIME_WEBRTC=1
# OPENAI_REALTIME_MODEL=gpt-4o-mini-realtime-preview-2024-12-17
# OPENAI_REALTIME_VOICE_MALE=echo
# OPENAI_REALTIME_VOICE_FEMALE=coral
# Turbo (activo por defeito). Desligar: EGO_REALTIME_PHONE_FAST=0
# EGO_REALTIME_PHONE_FAST=1
# EGO_REALTIME_VAD_EAGERNESS=high
# EGO_REALTIME_VAD_SILENCE_MS=200
# EGO_REALTIME_MAX_TOKENS_PHONE=96

# --- Conta de teste = plano Total (APENAS dev local — ignorado se EGO_API_ENV=production) ---
# EGO_TEST_TOTAL_EMAILS=seu-email@teste.com

# --- Aviso de atualização no app (Railway) — suba ao publicar APK/IPA novo ---
# EGO_LATEST_APP_VERSION=1.0.26
# EGO_PLAY_STORE_URL=https://play.google.com/apps/testing/com.egoai.app
# EGO_TESTFLIGHT_URL=https://testflight.apple.com/join/eNDKdFWF
# EGO_APP_UPDATE_MESSAGE=Nova versão disponível. Toque em Atualizar agora.

# --- Manutenção temporária (opcional) ---
# EGO_MAINTENANCE=1
# EGO_MAINTENANCE_MESSAGE=Atualizando o servidor. Tente em 1 minuto.

# --- Limites legado / dev ---
EGO_DAILY_MESSAGE_LIMIT=0
EGO_MONTHLY_TOKEN_LIMIT_FREE=500000
EGO_MONTHLY_TOKEN_LIMIT_PRO=10000000
EGO_CHAT_LLM_MAX_TURNS=24

# --- Stripe Checkout ---
STRIPE_CHECKOUT_CONNECTION_URL=
STRIPE_CHECKOUT_PREMIUM_URL=
STRIPE_CHECKOUT_TOTAL_URL=
STRIPE_CHECKOUT_ENTERPRISE_URL=
STRIPE_CHECKOUT_MENSAL_URL=
STRIPE_CHECKOUT_INT_CONNECTION_URL=
STRIPE_CHECKOUT_INT_PREMIUM_URL=
STRIPE_CHECKOUT_INT_TOTAL_URL=
STRIPE_CHECKOUT_INT_ENTERPRISE_URL=
# Webhook Stripe: STRIPE_SECRET_KEY= STRIPE_WEBHOOK_SECRET=
# Eventos no endpoint: checkout.session.completed, invoice.paid, charge.refunded
# STRIPE_PRICE_CONNECTION= STRIPE_PRODUCT_CONNECTION= (mapeia plano na receita)
# Receitas automáticas → Supabase stripe_revenue_ledger; no PC: python custo/financeiro/sincronizar_receitas_stripe.py
# FINANCE_DIR=custo/financeiro
# FINANCE_AUTO_RESUMO=true

# --- E-mail automático pós-cadastro ---
# EGO_SIGNUP_EMAIL_ENABLED=1
#
# Opção A — Brevo SMTP (recomendado no Railway; ver EMAIL-SMTP-RAILWAY-FIX.md):
# EGO_SMTP_HOST=smtp-relay.brevo.com
# EGO_SMTP_PORT=587
# EGO_SMTP_USE_TLS=1
# EGO_SMTP_USE_SSL=0
# EGO_SMTP_USER=seu-login-brevo
# EGO_SMTP_PASSWORD=chave-smtp-brevo
#
# Opção B — UOL direto (costuma dar timed out no Railway):
# EGO_SMTP_HOST=smtp.uol.com.br
# EGO_SMTP_USER=contato@egoai.com.br
# EGO_SMTP_PASSWORD=senha do e-mail no painel UOL
#
# Opção C — Resend HTTPS (após deploy com EGO_EMAIL_PROVIDER=resend):
# EGO_EMAIL_PROVIDER=resend
# RESEND_API_KEY=re_...
# EGO_RESEND_FROM=Ego-IA <contato@egoai.com.br>
#
# EGO_SMTP_FROM=contato@egoai.com.br
# EGO_SMTP_FROM_NAME=Ego-IA
# EGO_SMTP_BCC_SELF=1
# EGO_SMTP_TIMEOUT=90
# EGO_PLAY_STORE_URL=https://play.google.com/apps/testing/com.egoai.app

# --- Monitoramento (Sentry + alertas) ---
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=production
# ERROR_ALERT_WEBHOOK_URL=https://discord.com/api/webhooks/...  (ou Slack)

# --- Flask API (opcional) ---
# EGO_API_HOST=0.0.0.0
# EGO_API_PORT=5000
# EGO_CORS_ORIGINS=http://localhost:8081,http://127.0.0.1:8081,http://localhost:8084

# --- Produção (Railway) — ver RAILWAY-SEGURANCA-PRODUCAO.env.txt ---
# EGO_API_ENV=production
# EGO_ENFORCE_HTTPS=1
# EGO_PLAY_INTEGRITY=1
# EGO_PLAY_INTEGRITY_MODE=monitor
# EGO_PLAY_INTEGRITY=0
# EGO_PLAY_INTEGRITY=1
# EGO_PLAY_INTEGRITY_MODE=monitor
# EGO_PLAY_INTEGRITY_MODE=enforce
# GOOGLE_CLOUD_PROJECT_NUMBER=
# ANDROID_PACKAGE_NAME=com.egoai.app
# GOOGLE_SERVICE_ACCOUNT_JSON=
