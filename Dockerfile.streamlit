# EGO-AI — Streamlit (Railway). Imagem mínima.
FROM python:3.11-slim-bookworm

WORKDIR /app

ENV PYTHONUNBUFFERED=1 \
    STREAMLIT_SERVER_HEADLESS=true \
    STREAMLIT_BROWSER_GATHER_USAGE_STATS=false

COPY requirements-railway.txt .
RUN pip install --no-cache-dir -r requirements-railway.txt

RUN mkdir -p .streamlit
COPY .streamlit/config.toml .streamlit/
COPY app.py ego_supabase.py legal_copy.py ./

EXPOSE 8080

CMD ["sh", "-c", "exec python -m streamlit run app.py --server.port=${PORT:-8080} --server.address=0.0.0.0 --server.headless=true --server.fileWatcherType=none --browser.gatherUsageStats=false"]
