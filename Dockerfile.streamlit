# EGO-AI — app Streamlit (interface web)
FROM python:3.11-slim

WORKDIR /app

ENV PYTHONUNBUFFERED=1 \
    STREAMLIT_SERVER_HEADLESS=true \
    STREAMLIT_BROWSER_GATHER_USAGE_STATS=false

COPY requirements-railway.txt .
RUN pip install --no-cache-dir -r requirements-railway.txt

COPY app.py ego_supabase.py legal_copy.py ./
COPY .streamlit .streamlit

EXPOSE 8080

CMD sh -c 'exec streamlit run app.py --server.port=${PORT:-8080} --server.address=0.0.0.0 --server.headless=true --server.fileWatcherType=none'
